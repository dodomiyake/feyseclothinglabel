# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-side only, NEVER exposed to the browser.
# Used to bypass RLS for trusted operations (public enquiry submission,
# notifications, audit log, secure portal links). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL, used to build links inside emails.
NEXT_PUBLIC_SITE_URL=https://feyseclothinglabel.vercel.app

# Email notifications (optional) — from resend.com. Admin notifications go
# to business_settings.support_email, editable at /admin/settings/business.
# Without a domain verified in Resend, use their onboarding@resend.dev
# sandbox sender (works immediately, no setup) or your own verified domain.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Feyse Clothing Labels <onboarding@resend.dev>"

# HubSpot account Service Key — server-side only, NEVER prefix with
# NEXT_PUBLIC_. Used to sync submitted enquiries to CRM contacts and deals.
HUBSPOT_SERVICE_KEY=your-hubspot-service-key
