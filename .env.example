# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-side only, NEVER exposed to the browser.
# Used to bypass RLS for trusted operations (public enquiry submission,
# notifications, audit log, secure portal links). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
